PORT=3000
HOST=127.0.0.1
DATABASE_MODE=mariadb
DB_ENV=dev
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=stocksbuddha_dev
DB_USER=stocksbuddha
DB_PASSWORD=replace-with-a-local-password
DB_ROOT_PASSWORD=replace-with-a-different-local-root-password
DB_TLS=false
DBGATE_PORT=8082

# Required in MariaDB mode. Generate a unique random secret (at least 32 characters).
AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Exact public origin, no trailing slash/path. Production requires HTTPS.
AUTH_BASE_URL=http://localhost:3000
# Comma-separated exact proxy IPs/CIDRs. Empty means direct clients; never set a blanket trust/hop count.
AUTH_TRUSTED_PROXIES=
# Hostinger mailbox SMTP; mandatory in production. Use the mailbox password, not your hPanel password.
# Port 465 uses implicit TLS; 587 uses required STARTTLS. TLS certificate validation stays enabled.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@stocksbuddha.com
SMTP_PASSWORD=replace-with-your-mailbox-password
AUTH_EMAIL_FROM=support@stocksbuddha.com

SENTRY_DSN=https://8eec895cde107f7682f8a43a4c016c53@o4512352621625344.ingest.de.sentry.io/4512352834093136
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1
# Set to the same deployed commit SHA used by VITE_SENTRY_RELEASE.
SENTRY_RELEASE=stocksbuddha@local

# Opt in only for the production platform homepage after domain/content review.
# RA websites, accounts, workspaces, errors and previews remain noindex.
# Ignored in development and when ALLOW_PUBLIC_PREVIEW=true.
BRAND_SITE_INDEXABLE=false

# Private document storage. Set OAuth credentials only on the backend; see docs/GOOGLE_DRIVE.md.
GOOGLE_DRIVE_ACCOUNT=stocksbuddha@gmail.com
GOOGLE_DRIVE_ROOT_ID=19ZQV2tselQzTwzCM6UHSV4xYEwJBTqW1
GOOGLE_DRIVE_MAIN_ID=1_wA_2T3ieQkmm-kbtbmKqpoGPDjYoXTo
# Leave all three absent until Google Cloud setup and the one-time consent flow are ready.
# GOOGLE_DRIVE_CLIENT_ID=replace-with-your-google-drive-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=replace-with-your-google-drive-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-your-google-drive-refresh-token-auto-generated-after-one-time-consent-flow

# Investor onboarding: generate once, store privately and back up with encrypted evidence.
# MariaDB SMS and production onboarding require a retained 64-character lowercase hexadecimal key.
# Generate with openssl rand -hex 32; keep the same key for existing encrypted records.
# ONBOARDING_DATA_KEY=replace-with-64-lowercase-hex-characters
ONBOARDING_DEV_SKIP=true
# Keep false until every blocker in docs/SEBI_RA_REVIEW.md is resolved.
ONBOARDING_PRODUCTION_APPROVED=false
# Each RA uses its own private Cashfree credentials. The private Payment Gateway Settings tab overrides this fallback.
# Never put credentials in public website snapshots, branding or content.
# CASHFREE_MERCHANTS_JSON={"stocksbuddha":{"clientId":"replace-me","clientSecret":"replace-me","mode":"sandbox"}}

# SMS defaults to trial and rejects every destination except +919599400141.
SMS_MODE=trial
SMS_TENANT_DAILY_CAP=10
SMS_GLOBAL_DAILY_CAP=20
# RA KYC sender credentials/templates are encrypted through private Website > SMS settings.
# Global recovery MUST use a separate platform-owned SMS Horizon account, never shared with an RA.
# Requires configured SMTP security notifications. Do not commit real credentials.
# SMS_RECOVERY_SETTINGS_JSON={"username":"platform-account","apiKey":"replace-me","senderId":"HORIZN","entityId":"110100000000001","encoding":"txt","template":{"id":"110100000000002","text":"Your password reset code is {{otp}}. Valid for {{expiryMinutes}} minutes."}}
