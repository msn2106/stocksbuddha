{
  "name": "@ra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore \"**/node_modules/**\" --ignore \"**/dist/**\" src/main.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@ra/contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsup": "8.5.1",
    "vite": "7.3.7"
  }
}
