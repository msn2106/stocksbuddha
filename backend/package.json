{
  "name": "@ra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../node_modules/tsx/dist/cli.mjs watch --ignore \"**/node_modules/**\" --ignore \"**/dist/**\" src/main.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node ../scripts/run-tests.mjs unit tests",
    "test:integration": "node ../scripts/run-tests.mjs integration tests"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@ra/contracts": "0.1.0",
    "better-auth": "1.7.12",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsup": "8.5.1",
    "vite": "7.3.7"
  }
}
