{
  "name": "ra-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ra/backend",
    "build": "npm run typecheck && npm run build --workspace @ra/frontend && npm run build --workspace @ra/backend && npm run db:build",
    "start": "npm run start --workspace @ra/backend",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit && npm run db:typecheck",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:coverage": "node scripts/coverage.mjs",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "precommit:check": "node scripts/precommit.mjs",
    "precommit:fix": "node scripts/precommit.mjs --fix",
    "hooks:install": "git config core.hooksPath .githooks",
    "preinstall": "node scripts/check-dependency-policy.mjs",
    "security:policy": "node scripts/check-dependency-policy.mjs",
    "security:audit": "npm audit --workspaces --include-workspace-root --include=dev --audit-level=low",
    "security:audit:critical": "npm audit --package-lock-only --workspaces --include-workspace-root --include=dev --include=optional --audit-level=critical",
    "security:check": "npm run security:policy && npm run security:audit",
    "test:policy": "node scripts/run-tests.mjs integration scripts/tests",
    "db:build": "tsx database/build.ts",
    "db:migrate": "node --env-file-if-exists=backend/.env --import tsx database/cli.ts migrate",
    "db:migrate:status": "node --env-file-if-exists=backend/.env --import tsx database/cli.ts status",
    "db:seed:demo": "node --env-file-if-exists=backend/.env --import tsx database/cli.ts seed",
    "db:typecheck": "tsc --noEmit -p database/tsconfig.json",
    "test:database": "node --env-file-if-exists=backend/.env --import tsx --test --test-timeout=60000 backend/tests/integration/database.test.ts",
    "auth:bootstrap-owner": "node --env-file-if-exists=backend/.env --import tsx database/bootstrap-owner.ts",
    "test:e2e:organisations": "playwright test --config tests/organisation/playwright.config.ts",
    "drive:authorize": "node --env-file-if-exists=backend/.env --import tsx scripts/google-drive.ts authorize",
    "drive:check": "node --env-file-if-exists=backend/.env --import tsx scripts/google-drive.ts check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1 <12",
      "onFail": "error"
    }
  }
}
