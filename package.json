{
  "name": "ra-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ra/backend",
    "build": "npm run typecheck && npm run build --workspace @ra/frontend && npm run build --workspace @ra/backend",
    "start": "npm run start --workspace @ra/backend",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test": "npm run test:policy && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node scripts/check-dependency-policy.mjs",
    "security:policy": "node scripts/check-dependency-policy.mjs",
    "security:audit": "npm audit --workspaces --include-workspace-root --include=dev --audit-level=low",
    "security:check": "npm run security:policy && npm run security:audit",
    "test:policy": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1 <12",
      "onFail": "error"
    }
  }
}
